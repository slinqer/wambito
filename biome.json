{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/drizzle/meta",
      "!**/*.csv",
      "!apps/web/app/styles/tokens.css",
      "!apps/web/app/api/schema.d.ts",
      "!apps/mcp/src/api/schema.d.ts",
      "!apps/web/build",
      "!**/.claude",
      "!apps/mobile/ios/**/*.xcassets/**"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["apps/api/**", "apps/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "The API and MCP run on Node: no browser globals (their tsconfig has the DOM lib only for packages/crypto)",
                  "document": "The API and MCP run on Node: no browser globals",
                  "localStorage": "The API and MCP run on Node: no browser globals",
                  "sessionStorage": "The API and MCP run on Node: no browser globals"
                }
              }
            }
          }
        }
      }
    }
  ]
}
