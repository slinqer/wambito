<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget and the Quick Settings tile (spec section 7.1). Spanish is the default;
     values-en, values-it and values-pt have the others (test/tooling/android_strings_test.dart keeps
     their keys the same). The app's own words are in lib/l10n (ARB). -->
<resources>
    <!-- The figure's label: with budgets, money left or overspent; without, what was spent. -->
    <string name="widget_remaining">Te quedan</string>
    <string name="widget_over">Te pasaste</string>
    <string name="widget_spent">Gastado este mes</string>
    <!-- The same for an earlier month (the figures are from before today's month). -->
    <string name="widget_remaining_past">Te quedaron en %1$s</string>
    <string name="widget_over_past">Te pasaste en %1$s</string>
    <string name="widget_spent_past">Gastado en %1$s</string>
    <string name="widget_signed_out">Abre Wambito para empezar</string>
    <!-- Under the figure when it could not be refreshed for a while (offline). -->
    <string name="widget_stale">hace un rato</string>
    <!-- Settings' "Ocultar el monto en el widget". -->
    <string name="widget_hidden" translatable="false">••••</string>
    <!-- The buttons, read aloud: the same words as the ＋ and 🎤 on home. -->
    <string name="widget_add">Agregar gasto</string>
    <string name="widget_capture">Decir o escribir un gasto</string>
    <string name="widget_wambito">Wambito</string>
    <!-- The widget picker. -->
    <string name="widget_small_description">Lo que te queda este mes, y ＋ para anotar un gasto.</string>
    <string name="widget_medium_description">Wambito, lo que te queda este mes, ＋ y 🎤 para anotar.</string>
    <!-- The Quick Settings tile: opens quick capture, listening. -->
    <string name="tile_capture">Decir un gasto</string>
    <!-- With the amount hidden: a neutral label (nothing about how the month goes), and what
         TalkBack reads in place of the dots. -->
    <string name="widget_hidden_label">Este mes</string>
    <string name="widget_amount_hidden">Monto oculto</string>
    <!-- The progress bar, read aloud. -->
    <string name="widget_progress">%1$d %% del presupuesto gastado</string>

    <!-- The two local notices (spec section 7.2), posted by notices/. The title; the sentence is the text. -->
    <string name="notice_title" translatable="false">Wambi</string>
    <!-- "Hoy vence Arriendo" / "Hoy vencen Arriendo y Spotify". %1$s is the names, joined. -->
    <string name="notice_due_one">Hoy vence %1$s</string>
    <string name="notice_due_many">Hoy vencen %1$s</string>
    <!-- "A, B y C"; "e" instead of "y" before a word that starts with the sound i. -->
    <string name="notice_and">y</string>
    <string name="notice_and_i">e</string>
    <string name="notice_guest">Tus datos se borrarán en 15 días si no agregas tu correo. Si borras la app, también los pierdes.</string>
    <!-- One notification channel per notice: their names and what they are for, in the phone's settings. -->
    <string name="notice_channel_due">Pagos que vencen hoy</string>
    <string name="notice_channel_due_description">A las 9:00, un aviso con los pagos recurrentes que vencen ese día.</string>
    <string name="notice_channel_guest">Aviso si no tienes correo</string>
    <string name="notice_channel_guest_description">Un aviso si pasan 45 días sin abrir Wambito y tu cuenta no tiene correo.</string>
    <!-- Automatic capture (capture/CapturePoster.kt): the silent notification of a detected transaction.
         %1$s is the money, %2$s the merchant, %3$s the category. -->
    <string name="capture_noted">Anoté %1$s en %2$s · %3$s, ¿bien?</string>
    <string name="capture_noted_fallback">Anoté %1$s en %2$s · %3$s, ¿qué categoría?</string>
    <plurals name="capture_summary">
        <item quantity="one">%d gasto por revisar</item>
        <item quantity="other">%d gastos por revisar</item>
    </plurals>
    <plurals name="capture_sign_in">
        <item quantity="one">Inicia sesión para guardar %d gasto detectado</item>
        <item quantity="other">Inicia sesión para guardar %d gastos detectados</item>
    </plurals>
    <string name="capture_confirm">Bien</string>
    <string name="capture_change">Cambiar</string>
    <string name="capture_channel">Gastos detectados</string>
    <string name="capture_channel_description">Un aviso por cada gasto o ingreso que Wambito detecta en tus apps del banco.</string>
</resources>
