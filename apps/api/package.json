{
  "name": "@wambito/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "seed:admin": "tsx --env-file-if-exists=../../.env src/scripts/seed-admin.ts",
    "seed:e2e-preview": "tsx --env-file-if-exists=../../.env src/scripts/seed-e2e-preview.ts",
    "auth:generate": "auth generate --config src/scripts/auth-cli.ts --adapter drizzle --dialect postgresql --output ../../packages/db/src/schema/auth.ts -y",
    "build": "esbuild src/server.ts ../../packages/db/src/scripts/bootstrap.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --entry-names=[name] --legal-comments=none --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\"",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.11",
    "@better-auth/oauth-provider": "^1.7.11",
    "@better-auth/passkey": "^1.7.11",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@simplewebauthn/server": "13.3.3",
    "@wambito/core": "workspace:*",
    "@wambito/crypto": "workspace:*",
    "@wambito/db": "workspace:*",
    "@wambito/importers": "workspace:*",
    "better-auth": "^1.7.11",
    "hono": "^4.13.13",
    "nodemailer": "^7.0.13",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.28.2"
  }
}
