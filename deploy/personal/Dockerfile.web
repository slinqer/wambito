# Caddy with the personal install's web build inside. Build from the repository root (compose does):
#   docker build -f deploy/personal/Dockerfile.web .
# Run deploy/personal/up.sh instead of building by hand: it makes apps/web/build-personal first.
FROM caddy:2.11-alpine
COPY deploy/personal/Caddyfile /etc/caddy/Caddyfile
# The direct way (a server with its own public address): docker-compose.direct.yml runs this one.
COPY deploy/personal/Caddyfile.direct /etc/caddy/Caddyfile.direct
# The routes, imported by both.
COPY deploy/personal/routes.caddy /etc/caddy/routes.caddy
# /.well-known/assetlinks.json is filled from ANDROID_CERT_SHA256 each time the container starts.
COPY deploy/personal/assetlinks.json.template /etc/caddy/assetlinks.json.template
# /.well-known/apple-app-site-association (iOS Universal Links and passkeys), from IOS_TEAM_ID.
COPY deploy/personal/apple-app-site-association.template /etc/caddy/apple-app-site-association.template
COPY deploy/personal/web-entrypoint.sh /usr/local/bin/web-entrypoint.sh
COPY apps/web/build-personal/client /srv
ENTRYPOINT ["/usr/local/bin/web-entrypoint.sh"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
