# The personal install's routes: everything a site serves, whichever way requests reach it. Imported
# by Caddyfile (behind the Cloudflare tunnel). The client's address is read only as
# {vars.client_ip}: every site that imports this file must set client_ip first.
encode zstd gzip

# A minimal access log on stdout (docker compose logs web): when, who (the visitor's address,
# client_ip), what path, what status. Query strings are cut, so a sign-in code in a link never
# lands in a log, and no request or response headers are kept (cookies, tokens).
log {
	output stdout
	format filter {
		wrap json
		request>uri regexp \?.* ""
		request>headers delete
		request>tls delete
		resp_headers delete
	}
}
log_append visitor_ip {vars.client_ip}

# Same set as apps/web/public/_headers (which Cloudflare Pages reads and Caddy cannot), plus
# noindex: this is one person's install, not the public site.
header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
	X-Robots-Tag "noindex, nofollow"
	# Never shown inside another site's frame.
	Content-Security-Policy "frame-ancestors 'none'"
	-Server
}

# --- MCP: assistants (Claude, ChatGPT) reach the person's Wambito here, with an OAuth token. --
# The protected resource metadata (RFC 9728) tells them where to get one: the API's OAuth server.
@mcp path /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
handle @mcp {
	header ?Cache-Control "no-store"
	reverse_proxy mcp:3001 {
		header_up X-Forwarded-For {vars.client_ip}
	}
}

# The OAuth server's metadata where RFC 8414 puts it for the issuer https://<host>/api/auth:
# the well-known path followed by the issuer's path. The API serves it under /api.
handle /.well-known/oauth-authorization-server/api/auth {
	header ?Cache-Control "no-cache"
	rewrite * /api/.well-known/oauth-authorization-server/auth
	reverse_proxy api:3000
}

# --- API: the path is forwarded as is (the API serves everything under /api). ---------------
handle /api/* {
	# Not served on the internet: the API schema is for developers. It answers 404 here, before the
	# API sees the request. (OAuth, /api/auth/oauth2/*, is open: assistants use it.)
	@notPublic path /api/openapi.json
	respond @notPublic 404

	# Never cached, unless the API says otherwise.
	header ?Cache-Control "no-store"

	# The client's address as the only X-Forwarded-For entry, replacing anything the client sent;
	# the API trusts just this hop.
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {vars.client_ip}
	}
}

root * /srv

# --- Built files are named after their content: cache them for good. -----------------------
handle /assets/* {
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# --- The emails' images and fonts (apps/web/public/email): mail clients fetch them from another
# origin, and a font from another origin loads only with CORS. Cached a day: a changed image gets a
# new name (Gmail's proxy keeps an image by its URL).
handle /email/* {
	header Access-Control-Allow-Origin "*"
	header Cache-Control "public, max-age=86400"
	file_server
}

# --- Android App Links and passkeys: the app's package and signing certificates. The file is
# written when the container starts (web-entrypoint.sh, from ANDROID_CERT_SHA256) and is `[]`
# when none is set, never a 404. Android fetches it without redirects and reads it as JSON.
handle /.well-known/assetlinks.json {
	header Content-Type "application/json"
	header Cache-Control "no-cache"
	file_server
}

# --- iOS Universal Links and passkeys: the app's team id and bundle id. Written when the container
# starts (web-entrypoint.sh, from IOS_TEAM_ID); empty lists when none is set, never a 404. Apple
# fetches it without redirects and wants JSON, though the path has no extension.
handle /.well-known/apple-app-site-association {
	header Content-Type "application/json"
	header Cache-Control "no-cache"
	file_server
}

# --- The landing, roadmap, automatic capture page, privacy policy and account deletion page live on their own site: send visitors there (same path and query).
# A temporary redirect, so the landing can move without browsers remembering the old answer.
@pages path / /en /en/ /it /it/ /pt /pt/ /roadmap /roadmap/ /en/roadmap /en/roadmap/ /it/roadmap /it/roadmap/ /pt/roadmap /pt/roadmap/ /automatic-capture /automatic-capture/ /en/automatic-capture /en/automatic-capture/ /it/automatic-capture /it/automatic-capture/ /pt/automatic-capture /pt/automatic-capture/ /privacy /privacy/ /delete-account /delete-account/ /en/privacy /en/privacy/ /en/delete-account /en/delete-account/ /it/privacy /it/privacy/ /it/delete-account /it/delete-account/ /pt/privacy /pt/privacy/ /pt/delete-account /pt/delete-account/
handle @pages {
	header Cache-Control "no-cache"
	redir {$LANDING_URL}{uri} 302
}

# --- A path with a file extension is a file: a missing one is a 404, not the app. ----------
@file path_regexp \.[A-Za-z0-9]{1,8}$
handle @file {
	header Cache-Control "no-cache"
	file_server
}

# --- Every other path is a screen of the app (/app, /sign-in, /welcome/..., /auth/verify). --
# The SPA shell, always revalidated: after an update its script names change.
handle {
	header Cache-Control "no-cache"
	try_files {path} /__spa-fallback.html
	file_server
}
