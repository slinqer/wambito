# Local development defaults. Copy to .env.
# The API connects as wambito_app (row-level security applies); migrations run as the admin role.
DATABASE_URL=postgres://wambito_app:wambito_app@localhost:5433/wambito
DATABASE_ADMIN_URL=postgres://wambito:wambito@localhost:5433/wambito
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-0123456789
# The browser reaches the API through the web origin (Vite proxies /api to the API on PORT), so
# API_URL is the web origin + /api: Better Auth builds its URLs from it and its cookies stay
# first-party. The API serves every route under API_URL's path (/api/health, /api/auth/...).
API_URL=http://localhost:5173/api
WEB_URL=http://localhost:5173
# The MCP server (`pnpm --filter @wambito/mcp dev`): its public URL is the audience of assistants'
# access tokens, which the API checks. It reaches the API directly, and checks tokens against the
# issuer the API stamps on them (API_URL + /auth). Blank MCP_URL: the API accepts no OAuth token.
MCP_URL=http://localhost:3001/mcp
MCP_API_URL=http://localhost:3000/api
AUTH_ISSUER=http://localhost:5173/api/auth
MAIL_FROM=Wambito <hola@wambito.local>
SMTP_URL=smtp://localhost:1026
# RESEND_API_KEY=
PORT=3000
NODE_ENV=development
# Client IP for rate limiting. Behind your own proxy, list its ranges in TRUSTED_PROXIES; on a
# platform that sets a dedicated header (fly-client-ip, cf-connecting-ip…) set CLIENT_IP_HEADER.
# Production refuses to start with a bare, spoofable X-Forwarded-For.
# See docs/deploy/api.md. (docker-compose.yml trusts the local Vite proxy for development.)
CLIENT_IP_HEADER=x-forwarded-for
TRUSTED_PROXIES=
# Optional. Comma-separated emails allowed to sign in (case-insensitive); anyone else is refused and
# gets no email. Unset: everyone. See docs/deploy/personal.md.
# SIGN_IN_ALLOWLIST=
# Admin panel (see docs/admin.md). Empty or unset: the panel is off.
# Comma-separated user ids that may use it.
# ADMIN_USER_IDS=
# Optional comma-separated IPs/CIDRs it answers to; unset: any address.
# ADMIN_ALLOWED_IPS=
# End-to-end encryption preview (stage 2a). Comma-separated user ids whose finances live only as
# encrypted records; GET /v1/me says `encryption: "preview"` for them. Empty or unset: nobody.
# E2E_PREVIEW_USER_IDS=
# End-to-end tests only: pins the API's clock to an ISO instant (refused in production). Pass it
# when starting the stack for them: E2E_NOW=2026-10-21T15:00:00Z docker compose up -d (README).
# E2E_NOW=
# Optional. Accept a self-signed SMTP certificate (Proton Bridge), only for an SMTP_URL on this machine.
# SMTP_TLS_INSECURE=false
